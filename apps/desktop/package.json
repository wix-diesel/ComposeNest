{
  "name": "@composenest/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:contracts": "node scripts/check-contracts.mjs && node scripts/generate-form-contract.mjs --check",
    "generate:forms": "node scripts/generate-form-contract.mjs",
    "dev": "vite",
    "test:navigation": "node --experimental-strip-types --test scripts/navigation.test.mjs",
    "test:forms": "node --experimental-strip-types --test scripts/formModel.test.mjs && node scripts/template-form.test.mjs",
    "test:shell": "node scripts/shell.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
