{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the ComposeNest main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-bootstrap",
    "allow-get-settings",
    "allow-save-settings",
    "allow-diagnose-runtime",
    "allow-list-templates",
    "allow-reload-templates",
    "allow-list-instances",
    "allow-list-retained-storage",
    "allow-refresh-retained-storage",
    "allow-get-instance-detail",
    "allow-prepare-create",
    "allow-update-create-plan",
    "allow-view-create-plan",
    "allow-get-create-receipt",
    "allow-discard-create-plan",
    "allow-confirm-create",
    "allow-get-instance-actions",
    "allow-rename-instance",
    "allow-change-instance",
    "allow-get-instance-edit",
    "allow-edit-instance-ports"
  ]
}
